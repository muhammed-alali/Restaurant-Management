# SQLite Database Connection URL (local development, outside Docker)
DATABASE_URL="file:./dev.db"

# Auth.js secret (generate with: openssl rand -hex 32)
AUTH_SECRET="your-secret-here-min-32-chars-long"
NEXTAUTH_SECRET="your-secret-here-min-32-chars-long"

# Auth.js must trust the host header when NODE_ENV=production
AUTH_TRUST_HOST="true"

# Local dev URL (the Docker dev setup uses port 3020, see docker-compose.dev.yml)
NEXTAUTH_URL="http://localhost:3000"

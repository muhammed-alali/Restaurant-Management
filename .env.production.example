# ===========================================================================
# Restaurant Management — production environment TEMPLATE
# Copy to .env.production and replace the placeholder secrets:
#   cp .env.production.example .env.production
# ===========================================================================

# --- Public port -----------------------------------------------------------
# Host port exposed by Docker. 3010 is used here so it does not clash with
# local dev servers (3000) or other projects (3001, 3002, 8080, ...).
APP_PORT=3010

# --- Database --------------------------------------------------------------
# SQLite file stored in the named Docker volume mounted at /app/data.
DATABASE_URL=file:/app/data/prod.db

# --- Auth.js / NextAuth ----------------------------------------------------
# Generate strong values (must be at least 32 characters):
#   openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Required in production so Auth.js trusts the reverse proxy / host header.
AUTH_TRUST_HOST=true

# Public URL of the app. Must include the host port (APP_PORT).
# For a real server use e.g. https://restaurant.example.com
NEXTAUTH_URL=http://localhost:3010

# --- Seeding ---------------------------------------------------------------
# Set to true only for the first deploy to create demo data, then false.
SEED_DB=true
